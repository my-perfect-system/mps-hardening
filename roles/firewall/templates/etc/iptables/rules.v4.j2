# Generated by odem.hardening.firewall - do not edit by hand.
*filter
:INPUT {{ firewall_policies.input }} [0:0]
:FORWARD {{ firewall_policies.forward }} [0:0]
:OUTPUT {{ firewall_policies.output }} [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
{% if firewall_enable_icmp %}
-A INPUT -p icmp -j ACCEPT
{% endif %}
{% for port in firewall_tcp_ports %}
-A INPUT -p tcp --dport {{ port }} -m state --state NEW -j ACCEPT
{% endfor %}
{% for port in firewall_udp_ports %}
-A INPUT -p udp --dport {{ port }} -m state --state NEW -j ACCEPT
{% endfor %}
COMMIT
{% if firewall_enable_nat_ip_forwarding %}
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s {{ firewall_nat_source_network }} -o {{ firewall_nat_out_interface }} -j MASQUERADE
COMMIT
{% endif %}
